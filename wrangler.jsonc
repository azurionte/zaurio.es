{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dinerozaurio-preprod",
  "main": "./preprod-worker.js",
  "compatibility_date": "2026-08-16",
  "assets": {
    "directory": "./herramientas/dinerozaurio",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "preprod.dinerozaurio.zaurio.es",
      "custom_domain": true
    }
  ]
}
